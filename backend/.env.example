# Environment Variables Example for Socket.IO Chat App

# Database
MONGODB_URI_STRING=mongodb://localhost:27017/chat_app
# hoặc MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/chat_app

# Server Configuration  
PORT=5000
NODE_ENV=development

# Authentication
ACCESS_TOKEN_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Client URL for CORS (Frontend URL)
CLIENT_URL=http://localhost:3000
# Hoặc production: https://yourdomain.com

# Socket.IO Configuration (optional)
# SOCKET_IO_ORIGINS=http://localhost:3000,http://localhost:5173
# SOCKET_IO_TRANSPORTS=websocket,polling

# Logging Level (optional)
# LOG_LEVEL=debug